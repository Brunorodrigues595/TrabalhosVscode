		//faca/enquanto (do/while)
		faca{
			escreva("\nInforme sua idade (valores aceeitos de 5 a 150): ")
			leia(idade)
		}enquanto(idade<5 ou idade>150)

		escreva("\nIdade correta")
	}
}
