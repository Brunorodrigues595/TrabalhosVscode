programa
{
	
	funcao inicio()
	{
		//para(for) é elemento de reptição(loop)

		inteiro numero, contador

		//escreva("Digite um valor até 10: ")
		//leia(numero)
		limpa()

		/*para é conposto por 3 elementos, o primeiro é a inicialização,
		 * segundo é a condição, terceiro é o incremento ou decremento. todos separado por ponto ou virgula
		*/
		cadeia nome
		para(contador=1; contador<=5; contador++){
			escreva("Informe o nome do aluno")
			leia(nome)
			escreva("\n", nome)
		}
	}
}
