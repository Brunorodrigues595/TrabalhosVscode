programa
{
	
	funcao inicio()
	{
		inteiro nota
		
		faca{
			escreva("Digite uma nota: ")
			leia(nota)
		}enquanto(nota<0 ou nota>10)

		se(nota>=7){
			escreva("Aprovado")
			
		}senao se(nota>5){
			escreva("Recuperação")
			
		}senao{
			escreva("Reprovado")
			}
		
		
	}
}

